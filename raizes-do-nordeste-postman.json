{
  "info": {
    "name": "API Raízes do Nordeste - UNINTER 2026",
    "description": "Coleção oficial de testes da API RESTful Raízes do Nordeste organizada por módulos (Auth, Produtos, Pedidos, Pagamento e Erros/Validações).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080", "type": "string" },
    { "key": "token_admin", "value": "", "type": "string" },
    { "key": "token_cliente", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login válido (Cliente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) { pm.collectionVariables.set('token_cliente', jsonData.accessToken); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"maria@email.com\",\n  \"senha\": \"123456\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          }
        },
        {
          "name": "Login válido (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) { pm.collectionVariables.set('token_admin', jsonData.accessToken); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@raizes.com.br\",\n  \"senha\": \"123456\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Produtos",
      "item": [
        {
          "name": "Listar cardápio público",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/produtos"
          }
        }
      ]
    },
    {
      "name": "Pedidos",
      "item": [
        {
          "name": "Criar pedido via TOTEM",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_cliente}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unidadeId\": 1,\n  \"usuarioId\": 2,\n  \"canalPedido\": \"TOTEM\",\n  \"itens\": [\n    { \"produtoId\": 1, \"quantidade\": 2 },\n    { \"produtoId\": 2, \"quantidade\": 1 }\n  ]\n}"
            },
            "url": "{{base_url}}/pedidos"
          }
        },
        {
          "name": "Listar por canal (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "url": "{{base_url}}/pedidos?canalPedido=TOTEM"
          }
        }
      ]
    },
    {
      "name": "Pagamento",
      "item": [
        {
          "name": "Pagamento mock aprovado",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_cliente}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"formaPagamento\": \"PIX\",\n  \"simularRecusa\": false\n}"
            },
            "url": "{{base_url}}/pedidos/1/pagamento"
          }
        },
        {
          "name": "Pagamento mock recusado",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_cliente}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"formaPagamento\": \"CARTAO\",\n  \"simularRecusa\": true\n}"
            },
            "url": "{{base_url}}/pedidos/2/pagamento"
          }
        }
      ]
    },
    {
      "name": "Erros e Validações",
      "item": [
        {
          "name": "Acesso sem token (401)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/pedidos"
          }
        },
        {
          "name": "Perfil sem permissão (403)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_cliente}}" }
            ],
            "url": "{{base_url}}/pedidos"
          }
        },
        {
          "name": "Campo obrigatório ausente (422)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"maria@email.com\",\n  \"senha\": \"\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          }
        },
        {
          "name": "Formato inválido canalPedido (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_cliente}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unidadeId\": 1,\n  \"usuarioId\": 2,\n  \"canalPedido\": \"IFOOD\",\n  \"itens\": [{ \"produtoId\": 1, \"quantidade\": 1 }]\n}"
            },
            "url": "{{base_url}}/pedidos"
          }
        },
        {
          "name": "Produto inexistente (404)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_cliente}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unidadeId\": 1,\n  \"usuarioId\": 2,\n  \"canalPedido\": \"APP\",\n  \"itens\": [{ \"produtoId\": 999, \"quantidade\": 1 }]\n}"
            },
            "url": "{{base_url}}/pedidos"
          }
        },
        {
          "name": "Estoque insuficiente (409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_cliente}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unidadeId\": 1,\n  \"usuarioId\": 2,\n  \"canalPedido\": \"APP\",\n  \"itens\": [{ \"produtoId\": 1, \"quantidade\": 999 }]\n}"
            },
            "url": "{{base_url}}/pedidos"
          }
        }
      ]
    }
  ]
}